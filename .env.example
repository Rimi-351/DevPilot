# DevPilot Environment Configuration
PROJECT_NAME=DevPilot
VERSION=0.1.0
DEBUG=True
API_V1_STR=/api/v1

# Database Configuration
# Option A: Local SQLite (Zero install / No Docker)
DATABASE_URL=sqlite+aiosqlite:///./devpilot.db

# Option B: PostgreSQL Async (Production / Docker)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/devpilot

# DB Pool Settings (Ignored for SQLite)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO=False
